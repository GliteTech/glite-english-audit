# Python environments and caches
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Private development material: research notes, calibration corpora, model
# evaluations, and design references. Deleted before the public release; none of
# it may ever be committed (spec sections 3.7, 14.2).
temp/

# Everything the released product writes on a user's machine: runs, their
# snapshots and artifacts, calibration history, and operator configuration.
# Unlike temp/, this exists in a published checkout — it is created the first
# time someone runs an audit, and deleting it removes every trace of their runs.
runtime/

# Scratch git worktrees used to run parallel agents in isolation. They are
# checkouts of this same repository, so committing them would nest the tree
# inside itself.
.claude/worktrees/

# Operating system noise
.DS_Store
